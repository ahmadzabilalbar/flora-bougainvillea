# ── Admin auth ────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# 32+ random characters, e.g. `openssl rand -base64 32`
AUTH_SECRET=

# ── Google Sheets (leave empty to use the local .data/db.json in dev) ──
# The ID is the long string in the sheet URL: docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the service-account JSON, keeping the \n sequences
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Image uploads (Vercel Blob) ───────────────────────────────
# Added automatically when you connect a Blob store to the Vercel project.
BLOB_READ_WRITE_TOKEN=
